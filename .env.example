# Copier vers .env et renseigner. Ne jamais committer .env.
#
# L'application n'utilise AUCUNE de ces variables au moment du build :
# l'URL du projet et la clé publique anon sont écrites en dur dans
# src/integrations/supabase/client.ts, fichier généré par Lovable.
# Ce fichier ne sert donc qu'à l'outillage local (CLI Supabase, scripts).

# Mot de passe Postgres, utilisé par le CLI Supabase pour `supabase db push`.
# Le CLI le met en cache dans le trousseau après la première saisie : le
# renseigner ici est facultatif, et le laisser en clair est déconseillé.
SUPABASE_DB_PASSWORD=

# Conservées pour l'outillage et les scripts qui en dépendraient.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PROJECT_ID=<project-ref>
VITE_SUPABASE_PUBLISHABLE_KEY=<clé anon publique — publique par nature>
